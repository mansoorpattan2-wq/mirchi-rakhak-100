# Backend secrets: never prefix with VITE_. Configure in the inner app directory.
GEMINI_API_KEY=
# Choose a vision + structured-output model available to your Google AI project.
# Current documented example: gemini-3.8-flash. Verify access before enabling.
GEMINI_MODEL=
PLANT_DIAGNOSIS_PROVIDER=gemini

# To use OpenAI, set PLANT_DIAGNOSIS_PROVIDER=openai and fill both fields below.
# Select a Responses API model with image inputs and strict structured outputs.
# OpenAI API billing is separate from ChatGPT subscriptions.
OPENAI_API_KEY=
OPENAI_MODEL=

# Firebase browser configuration is public; AI credentials above remain backend-only.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Reserved for the later Supabase integration; current sign-in uses Firebase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
